<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationId>dev.libyuvsharp.tests</ApplicationId>
    <ApplicationTitle>LibYuvSharp Tests</ApplicationTitle>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
    <LibYuvPackageVersion Condition="'$(LibYuvPackageVersion)' == ''">2.0.0</LibYuvPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lennox.LibYuvSharp" Version="$(LibYuvPackageVersion)" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <Compile Include="../LibYuvSharp.Test/LibYuvTests.cs" Link="LibYuvTests.cs" />
    <EmbeddedResource Include="../LibYuvSharp.Test/solid-color.jpg" Link="solid-color.jpg" />
  </ItemGroup>
</Project>
